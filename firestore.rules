rules_version = '2';
// Regras do Firestore. Princípio: tudo é negado, exceto o que está liberado abaixo.
// Toda gravação é validada aqui, no servidor: campos, tipos, tamanhos, dono, hora e frequência.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function slug(s) { return s is string && s.matches('^[a-z0-9-]{2,24}$'); }
    function text(s, max) { return s is string && s.size() >= 1 && s.size() <= max; }
    function photoOk(s, max) { return s is string && s.size() <= max && s.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'); }
    function numIn(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    // Gravou agora o campo `field` do perfil e a gravação anterior foi há mais de 30 s.
    function throttled(field) {
      return getAfter(userPath()).data[field] == request.time
        && (!exists(userPath()) || !(field in get(userPath()).data)
            || get(userPath()).data[field] < request.time - duration.value(30, 's'));
    }
    function opt(d, k) { return !(k in d); }

    // ---------- versão pública ----------
    // Publicar exige conta Google E a claim "ageVerified" == true no token. Essa claim só pode ser
    // gravada por backend confiável (Admin SDK) depois de uma verificação de idade real.
    // O app nunca consegue gravá-la. Sem ela, nenhuma publicação nova passa.
    function google() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && ('google.com' in request.auth.token.firebase.identities);
    }
    function canPublish() { return google() && request.auth.token.get('ageVerified', false) == true; }
    // O feed público só abre quando a equipe grava config/public { feedOpen: true } pelo console
    // (com denúncia + responsável pela moderação definidos). Sem isso, cada um só vê os próprios posts.
    function feedOpen() {
      return exists(/databases/$(database)/documents/config/public)
        && get(/databases/$(database)/documents/config/public).data.get('feedOpen', false) == true;
    }
    function privPath(pid) { return /databases/$(database)/documents/posts_private/$(pid); }
    function ownsPost(pid) { return signedIn() && exists(privPath(pid)) && get(privPath(pid)).data.uid == request.auth.uid; }
    // Post antigo (antes da v2) tinha o campo uid no documento público.
    function legacyMine(d) { return signedIn() && ('uid' in d) && d.uid == request.auth.uid; }

    // Chaves de configuração: leitura livre, escrita só pelo console (Admin).
    match /config/{doc} {
      allow read: if true;
    }

    // Perfil mínimo: apelido e horários dos últimos posts. Só a própria pessoa lê e escreve.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['nick', 'lastPostAt', 'lastPostId', 'lastPlaceAt'])
        && text(request.resource.data.nick, 20)
        && (opt(request.resource.data, 'lastPostAt') || (request.resource.data.lastPostAt == request.time && canPublish())
            || (resource != null && request.resource.data.lastPostAt == resource.data.lastPostAt))
        && (opt(request.resource.data, 'lastPostId') || (request.resource.data.lastPostId is string && request.resource.data.lastPostId.size() <= 40))
        && (opt(request.resource.data, 'lastPlaceAt') || request.resource.data.lastPlaceAt == request.time
            || (resource != null && request.resource.data.lastPlaceAt == resource.data.lastPlaceAt));
    }

    // Post público (v: 2): só apelido, missão, XP, km, tempo, lugares e clube. Sem dono, foto ou trajeto.
    // Leitura pública só com o feed aberto e só de posts v2. O dono sempre lê e apaga os seus.
    // Posts antigos (com uid, foto e trajeto no documento) ficam visíveis só para o dono.
    match /posts/{pid} {
      allow get: if (feedOpen() && resource.data.get('v', 0) == 2) || ownsPost(pid) || legacyMine(resource.data);
      allow list: if (feedOpen() && resource.data.get('v', 0) == 2) || legacyMine(resource.data);
      allow create: if canPublish() && validPost(request.resource.data) && throttled('lastPostAt')
        && getAfter(userPath()).data.lastPostId == pid
        && existsAfter(privPath(pid)) && getAfter(privPath(pid)).data.uid == request.auth.uid;
      // Só o contador de aplausos muda, de 1 em 1, junto com o documento claps/{uid}. Só com o feed aberto.
      allow update: if signedIn() && feedOpen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claps'])
        && (
          (request.resource.data.claps == resource.data.claps + 1
            && !exists(/databases/$(database)/documents/posts/$(pid)/claps/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/posts/$(pid)/claps/$(request.auth.uid)))
          ||
          (request.resource.data.claps == resource.data.claps - 1
            && exists(/databases/$(database)/documents/posts/$(pid)/claps/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/posts/$(pid)/claps/$(request.auth.uid)))
        );
      // Apagar o próprio post continua permitido mesmo sem poder publicar.
      allow delete: if ownsPost(pid) || legacyMine(resource.data);

      match /claps/{uid} {
        allow read: if isMe(uid) || ownsPost(pid) || legacyMine(get(/databases/$(database)/documents/posts/$(pid)).data);
        allow create: if isMe(uid) && feedOpen() && request.resource.data.keys().hasOnly(['at'])
          && getAfter(/databases/$(database)/documents/posts/$(pid)).data.claps
             == get(/databases/$(database)/documents/posts/$(pid)).data.claps + 1;
        // Quem aplaudiu tira o aplauso (contador -1). O dono do post apaga os aplausos ao apagar o post.
        allow delete: if (isMe(uid)
          && getAfter(/databases/$(database)/documents/posts/$(pid)).data.claps
             == get(/databases/$(database)/documents/posts/$(pid)).data.claps - 1)
          || ownsPost(pid) || legacyMine(get(/databases/$(database)/documents/posts/$(pid)).data);
      }
    }
    // Parte privada do post: dono, foto reduzida e trajeto resumido. Só o dono lê e apaga.
    match /posts_private/{pid} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if canPublish()
        && request.resource.data.keys().hasOnly(['uid', 'photo', 'route', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (opt(request.resource.data, 'photo') || photoOk(request.resource.data.photo, 160000))
        && (opt(request.resource.data, 'route') || (request.resource.data.route is list && request.resource.data.route.size() <= 240))
        && existsAfter(/databases/$(database)/documents/posts/$(pid));
    }
    function validPost(d) {
      return d.keys().hasOnly(['v', 'kind', 'nick', 'missionId', 'missions', 'title', 'pet', 'pets', 'xp', 'km', 'mins', 'places', 'club', 'clubName', 'claps', 'createdAt'])
        && d.v == 2
        && d.kind in ['mission', 'expedition', 'place']
        && text(d.nick, 20) && slug(d.pet)
        && d.xp is int && d.xp >= 0 && d.xp <= 2000
        && d.claps == 0 && d.createdAt == request.time
        && (opt(d, 'missionId') || slug(d.missionId))
        && (opt(d, 'missions') || (d.missions is list && d.missions.size() <= 20))
        && (opt(d, 'pets') || (d.pets is list && d.pets.size() <= 10))
        && (opt(d, 'title') || text(d.title, 60))
        && (opt(d, 'km') || numIn(d.km, 0, 100))
        && (opt(d, 'mins') || (d.mins is int && d.mins >= 0 && d.mins <= 1440))
        && (opt(d, 'places') || (d.places is int && d.places >= 0 && d.places <= 50))
        && (opt(d, 'club') || (d.club is string && d.club.matches('^[A-Z2-9]{6}$') && text(d.clubName, 24)));
    }

    // Meta da cidade: só soma 1, e só junto com um post autorizado criado no mesmo lote
    // (o post lastPostId não existia antes e passa a existir agora).
    // Crie stats/city com { photos: 0 } pelo console antes de abrir o jogo.
    function newPostInBatch() {
      let pid = getAfter(userPath()).data.lastPostId;
      return getAfter(userPath()).data.lastPostAt == request.time
        && !exists(/databases/$(database)/documents/posts/$(pid))
        && existsAfter(/databases/$(database)/documents/posts/$(pid));
    }
    match /stats/{doc} {
      allow read: if true;
      allow update: if doc == 'city' && canPublish()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos'])
        && request.resource.data.photos == resource.data.photos + 1
        && newPostInBatch();
    }

    // Lugares marcados pelos jogadores. Quem marca já conta como 1 visita.
    // Marcar lugar é publicação pública (foto + coordenadas): exige canPublish().
    // PENDENTE: lugares antigos guardam uid no documento público (ver README, migração).
    match /places/{id} {
      allow read: if true;
      allow create: if canPublish()
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'name', 'type', 'lat', 'lng', 'confirms', 'photo', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.nick, 20)
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.type in ['agua', 'mata', 'praca', 'mirante', 'comercio']
        && numIn(request.resource.data.lat, -90, 90) && numIn(request.resource.data.lng, -180, 180)
        && request.resource.data.confirms == 1
        && request.resource.data.createdAt == request.time
        && (opt(request.resource.data, 'photo') || photoOk(request.resource.data.photo, 120000))
        && existsAfter(/databases/$(database)/documents/places/$(id)/visits/$(request.auth.uid))
        && throttled('lastPlaceAt');
      // Confirmação: +1, uma por pessoa (documento visits/{uid}).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirms'])
        && request.resource.data.confirms == resource.data.confirms + 1
        && !exists(/databases/$(database)/documents/places/$(id)/visits/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/places/$(id)/visits/$(request.auth.uid));
      allow delete: if isMe(resource.data.uid);

      match /visits/{uid} {
        allow read: if isMe(uid) || (signedIn() && get(/databases/$(database)/documents/places/$(id)).data.uid == request.auth.uid);
        // O dono do lugar apaga as visitas ao apagar o lugar (exclusão de dados).
        allow delete: if signedIn() && get(/databases/$(database)/documents/places/$(id)).data.uid == request.auth.uid;
        allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['at'])
          && (!exists(/databases/$(database)/documents/places/$(id))
              || getAfter(/databases/$(database)/documents/places/$(id)).data.confirms
                 == get(/databases/$(database)/documents/places/$(id)).data.confirms + 1);
      }
    }

    // "Este lugar é meu?": só cria. A equipe confere o dono por telefone ou nota antes de valer.
    match /claims/{cid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['placeId', 'store', 'contact', 'plan', 'consent', 'createdAt'])
        && request.resource.data.placeId is string && request.resource.data.placeId.size() <= 40
        && text(request.resource.data.store, 60) && text(request.resource.data.contact, 60)
        && request.resource.data.plan in ['gratis', 'parceiro']
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
    }

    // Missão criada pela loja: entra pendente. Só aparece no jogo quando a equipe muda status para 'ok'.
    match /storeMissions/{mid} {
      allow read: if resource.data.status == 'ok';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'store', 'model', 'subject', 'gift', 'pet', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && text(request.resource.data.store, 60) && text(request.resource.data.subject, 60)
        && request.resource.data.gift is string && request.resource.data.gift.size() <= 60
        && request.resource.data.model in ['foto', 'visitas', 'sabado', 'dupla']
        && slug(request.resource.data.pet)
        && request.resource.data.createdAt == request.time;
    }

    // Denúncia de post: só cria. A equipe lê pelo console.
    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'reason', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string && request.resource.data.postId.size() <= 40
        && request.resource.data.reason in ['pessoa', 'ofensivo', 'perigo', 'outro']
        && request.resource.data.createdAt == request.time;
    }

    // Pedido de impressão: só um código. A foto nunca é enviada.
    match /orders/{oid} {
      allow read, delete: if isMe(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'code', 'missionId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{6}$')
        && slug(request.resource.data.missionId)
        && request.resource.data.createdAt == request.time;
    }

    // Contato de lojista: só cria. Ninguém lê pelo app.
    match /leads/{lid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['store', 'contact', 'consent', 'createdAt'])
        && text(request.resource.data.store, 60) && text(request.resource.data.contact, 60)
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
